# --- Required ---------------------------------------------------------------------------------------------------------
DB_JANUS_PASSWORD=              # password of the `janus` role on the shared PostgreSQL
JANUS_INTERNAL_TOKEN=           # shared secret between the Next.js proxy and FastAPI (long random string)
AUTH_SECRET=                    # better-auth session secret (openssl rand -base64 32)
JANUS_HOST=                     # public host name served by Traefik (also the auth base URL)

# --- Optional: each block turns on one feature; leave empty to keep it off --------------------------------------------
# Redis (notification debounce store, used by the worker)
REDIS_PASSWORD=
# Pi-hole network provider (DHCP reservations, DNS log)
JANUS_PIHOLE_PASSWORD=
# Gotify notifications (Settings > Integrations)
GOTIFY_HOST=
JANUS_GOTIFY_TOKEN=
# E-mail notifications (Settings > Integrations); SMTP_NOREPLY_USER is also the sender
SMTP_HOST=
SMTP_NOREPLY_USER=
SMTP_NOREPLY_PASSWORD=
JANUS_NOTIFY_EMAIL=
# SMTP transport: ssl (default, port 465) | starttls | none; change JANUS_SMTP_PORT in docker-compose.yml with it
JANUS_SMTP_SECURITY=
# Authentik / OIDC sign-in (Settings > Sign-in & users); without it only password login exists
AUTHENTIK_HOST=
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
# Allowlist of e-mails that may sign in through OIDC (local users are not subject to it)
JANUS_ALLOWED_EMAILS=
# First local admin, created only when there is no user yet (otherwise use /setup)
JANUS_ADMIN_USERNAME=
JANUS_ADMIN_PASSWORD=
# Key for secrets stored in the database (OIDC secrets, Gotify token, SMTP password); falls back to JANUS_INTERNAL_TOKEN
JANUS_SECRET_KEY=
# Which provider holds the DHCP / DNS role: a kind (pihole, unifi) or none; unset keeps Pi-hole when its password is set
JANUS_DHCP_PROVIDER=
JANUS_DNS_PROVIDER=
# UniFi network provider (Settings > Network providers)
JANUS_UNIFI_URL=
JANUS_UNIFI_USERNAME=
JANUS_UNIFI_PASSWORD=
# Guest DHCP pool (Settings > Guests); set both or neither
JANUS_GUEST_START=
JANUS_GUEST_END=
# libpq URL of the better-auth database; empty derives it from the database URL (the compose default)
AUTH_DATABASE_URL=
