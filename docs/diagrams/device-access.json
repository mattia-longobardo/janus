      "dot": "cyan",
      "title": "Discovery",
      "items": [
        "The sentinel records every new MAC as Pending (device.new)",
        "The gateway MAC is recorded as Authorized automatically"
      ]
    },
    {
      "dot": "emerald",
      "title": "Enforcement",
      "items": [
        "Approve picks a free IP in the group range and a DNS-safe hostname",
        "In apply mode the API writes the Pi-hole reservation at once and revokes the quarantine lease",
        "In dry-run mode only the database changes"
      ]
    },
    {
      "dot": "rose",
      "title": "Denial",
      "items": [
        "Block drops the reservation and revokes the current lease",
        "A blocked device can be approved again later"
      ]
    }
