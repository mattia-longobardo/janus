  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Traefik routes to Next.js on :3000",
        "better-auth signs in with password or optional OIDC; users live in the auth schema, OIDC users only if allowlisted",
        "Only signed-in, same-origin requests reach FastAPI with the internal token"
      ]
    },
    {
      "dot": "emerald",
      "title": "Background",
      "items": [
        "Worker every 5 min: provider reconcile; every minute: presence, DNS check, identity, expired guests; every 15 s: alert dispatch",
        "Sentinel sniffs ARP/DHCP/mDNS/NetBIOS/SSDP and sweeps ARP",
        "Scanner runs nmap -sT -sV on scan-enabled groups"
      ]
    },
    {
      "dot": "amber",
      "title": "Network providers",
      "items": [
        "The registry discovers providers; each holds the DHCP and/or DNS role (Pi-hole both, UniFi DHCP)",
        "dry-run logs the reservation diff; apply writes it",
        "Unknown devices stay in the quarantine pool; guests use a separate pool"
      ]
    }
  ]
